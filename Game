# sonic_emulator_fast.py
import pygame
import sys
import random

pygame.init()
pygame.mixer.init()

# Звуки
try:
    jump_sound = pygame.mixer.Sound(bytes([130, 120, 100, 90, 110]*100))
    ring_sound = pygame.mixer.Sound(bytes([150, 140, 160, 130]*150))
    hit_sound = pygame.mixer.Sound(bytes([80, 70, 60, 50]*200))
except:
    class DummySound:
        def play(self): pass
    jump_sound = ring_sound = hit_sound = DummySound()

# Настройки
W, H = 800, 400
screen = pygame.display.set_mode((W, H))
pygame.display.set_caption("Sonic Fast")
clock = pygame.time.Clock()

# Цвета
BLUE, GREEN, RED, YELLOW, WHITE, BLACK = (0,120,255), (0,180,0), (255,0,0), (255,255,0), (255,255,255), (0,0,0)

# Игрок
sonic = {'x': 100, 'y': 300, 'vy': 0, 'facing': True, 'rings': 0, 'lives': 3}

# Уровень
platforms = [(0, 350, W, 50), (200, 250, 100, 20), (400, 200, 100, 20)]
rings = [(random.randint(50, W-50), random.randint(100, 330)) for _ in range(10)]
enemies = [{'x': 300, 'y': 330, 'dir': 1}, {'x': 500, 'y': 330, 'dir': -1}]
anim_timer = 0

def draw_sonic():
    x, y = sonic['x'], sonic['y']
    frame = (anim_timer // 5) % 2
    
    if sonic['facing']:
        pygame.draw.rect(screen, BLUE, (x, y, 20, 30))
        pygame.draw.rect(screen, BLUE, (x+15, y-10, 15, 15))
        pygame.draw.rect(screen, WHITE, (x+25, y-5, 5, 5))
        if frame == 0:
            pygame.draw.polygon(screen, BLUE, [(x+20, y-15), (x+30, y-5), (x+20, y-5)])
        else:
            pygame.draw.polygon(screen, BLUE, [(x+25, y-15), (x+35, y-5), (x+25, y-5)])
        pygame.draw.rect(screen, RED, (x+5, y+30, 5, 10 if frame==0 else 5))
        pygame.draw.rect(screen, RED, (x+15, y+30, 5, 5 if frame==0 else 10))
    else:
        pygame.draw.rect(screen, BLUE, (x, y, 20, 30))
        pygame.draw.rect(screen, BLUE, (x-10, y-10, 15, 15))
        pygame.draw.rect(screen, WHITE, (x-5, y-5, 5, 5))
        if frame == 0:
            pygame.draw.polygon(screen, BLUE, [(x, y-15), (x-10, y-5), (x, y-5)])
        else:
            pygame.draw.polygon(screen, BLUE, [(x-5, y-15), (x-15, y-5), (x-5, y-5)])
        pygame.draw.rect(screen, RED, (x+10, y+30, 5, 10 if frame==0 else 5))
        pygame.draw.rect(screen, RED, (x, y+30, 5, 5 if frame==0 else 10))

def physics():
    sonic['vy'] += 0.5
    sonic['y'] += sonic['vy']
    
    on_ground = False
    for p in platforms:
        if (sonic['x'] < p[0]+p[2] and sonic['x']+20 > p[0] and 
            sonic['y'] < p[1]+p[3] and sonic['y']+40 > p[1] and sonic['vy'] > 0):
            sonic['y'] = p[1] - 40
            sonic['vy'] = 0
            on_ground = True
    
    if sonic['y'] > H:
        hit_sound.play()
        sonic.update({'x': 100, 'y': 300, 'vy': 0})
        sonic['lives'] -= 1
        if sonic['lives'] <= 0:
            return False
    return True

def update_game():
    # Кольца
    for r in rings[:]:
        if abs(sonic['x'] - r[0]) < 20 and abs(sonic['y'] - r[1]) < 20:
            rings.remove(r)
            sonic['rings'] += 1
            ring_sound.play()
    
    # Враги
    for e in enemies:
        e['x'] += 3 * e['dir']
        if e['x'] <= 0 or e['x'] >= W-20: e['dir'] *= -1
        
        if (abs(sonic['x'] - e['x']) < 20 and abs(sonic['y'] - e['y']) < 20):
            if sonic['vy'] > 0: 
                e['x'] = -100
                sonic['rings'] += 5
            else: 
                hit_sound.play()
                sonic.update({'x': 100, 'y': 300, 'vy': 0})
                sonic['lives'] -= 1
                if sonic['lives'] <= 0: return False
    return True

# Главный цикл
running = True
while running:
    screen.fill(GREEN)
    
    for event in pygame.event.get():
        if event.type == pygame.QUIT: running = False
        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_SPACE and sonic['vy'] == 0: 
                sonic['vy'] = -12
                jump_sound.play()
    
    keys = pygame.key.get_pressed()
    if keys[pygame.K_LEFT]: 
        sonic['x'] -= 5
        sonic['facing'] = False
    if keys[pygame.K_RIGHT]: 
        sonic['x'] += 5
        sonic['facing'] = True
    
    if not physics() or not update_game(): running = False
    
    # Отрисовка
    for p in platforms: pygame.draw.rect(screen, BROWN, p)
    for r in rings: pygame.draw.circle(screen, YELLOW, r, 8, 2)
    for e in enemies: 
        pygame.draw.rect(screen, RED, (e['x'], e['y'], 20, 15))
        pygame.draw.rect(screen, WHITE, (e['x']+5, e['y']+3, 4, 4))
        pygame.draw.rect(screen, WHITE, (e['x']+11, e['y']+3, 4, 4))
    
    draw_sonic()
    
    # HUD
    font = pygame.font.Font(None, 24)
    screen.blit(font.render(f"RINGS: {sonic['rings']}", True, YELLOW), (10, 10))
    screen.blit(font.render(f"LIVES: {sonic['lives']}", True, WHITE), (10, 40))
    
    pygame.display.flip()
    anim_timer += 1
    clock.tick(60)

pygame.quit()
sys.exit()
